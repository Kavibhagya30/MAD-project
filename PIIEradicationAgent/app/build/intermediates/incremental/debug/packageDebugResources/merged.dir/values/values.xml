    <style name="Theme.PIIAgent" parent="Theme.Material3.Dark.NoActionBar">
        
        <item name="colorPrimary">@color/dark_blue_variant</item>
        <item name="colorOnPrimary">@color/text_primary</item>
        <item name="colorPrimaryContainer">@color/card_blue</item>
