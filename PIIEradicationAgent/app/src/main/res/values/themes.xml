<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme, Material 3 dark cybersecurity variant -->
    <style name="Theme.PIIAgent" parent="Theme.Material3.Dark.NoActionBar">
        <!-- Primary brand color (dark blue) -->
        <item name="colorPrimary">@color/dark_blue_variant</item>
        <item name="colorOnPrimary">@color/text_primary</item>
        <item name="colorPrimaryContainer">@color/card_blue</item>
        <item name="colorOnPrimaryContainer">@color/text_primary</item>

        <!-- Secondary (green accent) -->
        <item name="colorSecondary">@color/accent_green</item>
        <item name="colorOnSecondary">@color/text_on_accent</item>
        <item name="colorSecondaryContainer">@color/accent_green_muted</item>
        <item name="colorOnSecondaryContainer">@color/accent_green</item>

        <!-- Tertiary (purple highlight) -->
        <item name="colorTertiary">@color/accent_purple</item>
        <item name="colorOnTertiary">@color/text_primary</item>
        <item name="colorTertiaryContainer">@color/accent_purple_muted</item>
        <item name="colorOnTertiaryContainer">@color/accent_purple</item>

        <!-- Error / risk reused with orange for warnings elsewhere -->
        <item name="colorError">@color/status_danger</item>
        <item name="colorOnError">@color/text_primary</item>

        <!-- Surfaces & background -->
        <item name="android:colorBackground">@color/deep_navy</item>
        <item name="colorSurface">@color/surface_blue</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/divider_blue</item>

        <!-- System bars -->
        <item name="android:statusBarColor">@color/deep_navy</item>
        <item name="android:navigationBarColor">@color/deep_navy</item>
        <item name="android:windowLightStatusBar">false</item>

        <item name="android:windowBackground">@color/deep_navy</item>
    </style>

    <!-- Splash screen theme -->
    <style name="Theme.PIIAgent.Splash" parent="Theme.PIIAgent">
        <item name="android:windowBackground">@drawable/bg_splash</item>
        <item name="android:statusBarColor">@color/deep_navy</item>
    </style>

    <!-- Rounded card style used across the app -->
    <style name="Widget.PIIAgent.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">4dp</item>
        <item name="cardBackgroundColor">@color/card_blue</item>
        <item name="strokeWidth">0dp</item>
        <item name="contentPadding">16dp</item>
    </style>

    <!-- Primary filled button (green) -->
    <style name="Widget.PIIAgent.Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/accent_green</item>
        <item name="android:textColor">@color/text_on_accent</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Secondary outlined button (purple) -->
    <style name="Widget.PIIAgent.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/accent_purple</item>
        <item name="android:textColor">@color/accent_purple</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Text input layout style -->
    <style name="Widget.PIIAgent.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="boxStrokeColor">@color/accent_green</item>
        <item name="hintTextColor">@color/accent_green</item>
        <item name="android:textColorHint">@color/text_secondary</item>
        <item name="boxBackgroundColor">@color/surface_blue</item>
    </style>

</resources>
